{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug @NAME@ (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/@TARGET@",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "Build @NAME@",
            "externalConsole": false,
            "pipeTransport": {
                "pipeProgram": "${workspaceFolder}/.vscode/host-run.sh",
                "pipeArgs": [],
                "debuggerPath": "gdb",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            }
        },
        {
            "name": "Debug @NAME@ (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/@TARGET@.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "Build @NAME@"
        }
    ]
}
